# Copy to .env (never commit .env). Every variable the code reads must be listed here.
# Values below are placeholders for the lab.

# --- Database
DATABASE_URL=postgresql://learnops:CHANGE_ME@db:5432/learnops

# --- Moodle sites (lab)
MOODLE45_URL=https://moodle45.lab.invalid
MOODLE53_URL=https://moodle53.lab.invalid
MOODLE_WS_TOKEN=CHANGE_ME            # service-account token (PRD B4); one per site in real deployments

# --- LTI 1.3 (PRD B3)
LTI_ISSUER=https://moodle45.lab.invalid
LTI_CLIENT_ID=CHANGE_ME
LTI_DEPLOYMENT_ID=CHANGE_ME
LTI_PRIVATE_KEY_PATH=/run/secrets/lti_private_key.pem

# --- Environment
LEARNOPS_ENV=lab                     # test | lab | production. Unset counts as "not test".

# --- Model interface (PRD B5)
MODEL_PROVIDER=local                 # local | hosted (fake: automated tests only, see MODEL_ALLOW_FAKE)
MODEL_ALLOW_FAKE=false               # true only with LEARNOPS_ENV=test; any other env refuses to start. Also covers SPEECH_PROVIDER
MODEL_NAME=CHANGE_ME
MODEL_LOCAL_URL=http://ai.lab.invalid:11434
MODEL_HOSTED_API_KEY=                # only for the comparison study; spending-capped key from the guide

# --- Speech interface (PRD B5.4)
SPEECH_PROVIDER=local                # local | hosted
SPEECH_LOCAL_URL=http://ai.lab.invalid:9000
SPEECH_HOSTED_API_KEY=

# --- Media store (PRD B6)
MEDIA_STORAGE=local                  # local | s3
MEDIA_ROOT=/srv/learnops-media
MEDIA_BASE_URL=https://media.lab.invalid
MEDIA_SIGNING=none                   # none | hmac | s3  (B6.4)
MEDIA_PATH_TEMPLATE=courses/{course_slug}/{module_nn}-{module_slug}/{lesson_nn}-{lesson_slug}/
UPLOAD_CHUNK_MB=90
RETENTION_RAW_DAYS=30

# --- BigBlueButton (lab)
BBB_URL=https://bbb.lab.invalid/bigbluebutton/
BBB_SECRET=CHANGE_ME

# --- Feature flags (PRD EXT-05)
FEATURE_SUMMARIES=true
FEATURE_SLIDE_INDEX=true
FEATURE_LOWRES_360P=false
FEATURE_PRACTICE=false
