  ],
  "readme_cases": [
    {
      "id": "readme-headings-any-case",
      "title": "ATX headings of any level match the listed names, ignoring case",
      "status": "derived",
      "covers": [
        "B1.3-readme-headings"
      ],
      "check": "readme_sections:Setup,Usage",
      "files": [
        {
          "name": "README.md",
          "text": "# My project\n\n## setup\n\nRun the installer.\n\n### Usage\n\nStart it."
        }
      ],
      "expected": {
        "result": "pass"
      }
    },
    {
      "id": "readme-setext-and-fenced-are-not-headings",
      "title": "A Setext heading and a # line inside a fenced code block are not headings",
      "status": "derived",
      "covers": [
        "B1.3-readme-headings"
      ],
      "check": "readme_sections:Overview,Setup,Usage,Install",
      "files": [
        {
          "name": "README.md",
          "text": "# Overview\n\nSetup\n=====\n\nUsage\n-----\n\n```text\n# Install\n```"
        }
      ],
      "expected": {
        "result": "fail",
        "missing": [
          "Setup",
          "Usage",
          "Install"
        ]
      }
    },
    {
      "id": "readme-only-root-readme-md",
      "title": "Only README.md at the repository root is read, not a README in a subfolder or with another name",
      "status": "derived",
      "covers": [
        "B1.3-readme-file"
      ],
      "check": "readme_sections:Setup,Usage,Install",
      "files": [
        {
          "name": "README.md",
          "text": "# Setup"
        },
        {
          "name": "docs/README.md",
          "text": "# Usage"
        },
        {
          "name": "README.rst",
          "text": "# Install"
        }
      ],
      "expected": {
        "result": "fail",
        "missing": [
          "Usage",
          "Install"
        ]
      }
    },
    {
      "id": "readme-name-with-semicolon",
      "title": "A semicolon in a section name splits the check, and the second part is an unknown check",
      "status": "derived",
      "covers": [
        "B1.3-readme-name-chars"
      ],
      "check": "readme_sections:Setup;Usage",
      "files": [
        {
          "name": "README.md",
          "text": "# Setup\n\n# Usage"
        }
      ],
      "expected": {
        "result": "invalid",
        "unknown_check": "Usage"
      }
    },
    {
      "id": "readme-heading-must-match-whole-text",
      "title": "A section name is matched against the whole heading text: Setup instructions does not satisfy Setup",
      "status": "derived",
      "covers": [
        "B1.3-readme-headings"
      ],
      "check": "readme_sections:Setup,Usage",
      "files": [
        {
          "name": "README.md",
          "text": "## Setup instructions\n\n## Usage"
        }
      ],
      "expected": {
        "result": "fail",
        "missing": [
          "Setup"
        ]
      }
    },
    {
      "id": "readme-closing-hashes-tab-and-trailing-spaces",
      "title": "A closing # sequence and trailing spaces are removed, and a tab may follow the opening #",
      "status": "derived",
      "covers": [
        "B1.3-readme-headings"
      ],
      "check": "readme_sections:Setup,Usage,Install",
      "files": [
        {
          "name": "README.md",
          "text": "## Setup ##\n\n#\tUsage\n\n### Install   "
        }
      ],
      "expected": {
        "result": "pass"
      }
    },
    {
      "id": "readme-tilde-and-unclosed-fences",
      "title": "A tilde fence and a fence that is never closed both hide the # lines inside them",
      "status": "derived",
      "covers": [
        "B1.3-readme-headings"
      ],
      "check": "readme_sections:Overview,Install,Deploy",
      "files": [
        {
          "name": "README.md",
          "text": "# Overview\n\n~~~\n# Install\n~~~\n\n```\n# Deploy"
        }
      ],
      "expected": {
        "result": "fail",
        "missing": [
          "Install",
          "Deploy"
        ]
      }
    }
  ]
}
