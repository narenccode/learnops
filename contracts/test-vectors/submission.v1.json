        "files": []
      },
      "expected": {
        "repository": {
          "error": "field_missing"
        },
        "demo": {
          "value": "https://example.org/gina/demo"
        },
        "report": {
          "error": "field_missing"
        }
      }
    },
    {
      "id": "report-as-txt",
      "title": "No Report section and no report.md: report.txt is the report",
      "status": "derived",
      "covers": [
        "B1.5-4",
        "B1.3-word_count"
      ],
      "input": {
        "onlinetext": "Repository: https://example.org/hugo/demo-assistant\nDemo: https://example.org/hugo/demo",
        "onlinetext_format": "plain",
        "files": [
          {
            "name": "report.txt",
            "text": "I wrote this in plain text. It has no headings."
          }
        ]
      },
      "expected": {
        "repository": {
          "value": "https://example.org/hugo/demo-assistant"
        },
        "demo": {
          "value": "https://example.org/hugo/demo"
        },
        "report": {
          "value": "I wrote this in plain text. It has no headings.",
          "source": "report.txt",
          "words": 10
        }
      }
    },
    {
      "id": "report-md-before-txt",
      "title": "Both report files exist: report.md is the report and report.txt is ignored",
      "status": "derived",
      "covers": [
        "B1.5-4",
        "B1.3-word_count"
      ],
      "input": {
        "onlinetext": "Repository: https://example.org/iris/demo-assistant\nDemo: https://example.org/iris/demo",
        "onlinetext_format": "plain",
        "files": [
          {
            "name": "report.md",
            "text": "# Notes\n\nThe markdown file wins."
          },
          {
            "name": "report.txt",
            "text": "The text file is ignored."
          }
        ]
      },
      "expected": {
        "repository": {
          "value": "https://example.org/iris/demo-assistant"
        },
        "demo": {
          "value": "https://example.org/iris/demo"
        },
        "report": {
          "value": "# Notes\n\nThe markdown file wins.",
          "source": "report.md",
          "words": 6
        }
      }
    },
    {
      "id": "misspelled-and-inline-labels",
