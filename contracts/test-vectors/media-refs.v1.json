        "flag-https"
      ],
      "input_kind": "package",
      "body": {
        "format": "markdown",
        "text": "![Diagram](https://example.invalid/media/diagram.png)"
      },
      "expected": {
        "media_refs": [
          "https://example.invalid/media/diagram.png"
        ],
        "ck12_flagged": [
          "https://example.invalid/media/diagram.png"
        ]
      }
